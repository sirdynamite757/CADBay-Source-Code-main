{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "firefox",
            "request": "launch",
            "name": "Launch Firefox - CADBay",
            "url": "http://localhost:3000",
            "pathMapping": [
                {
                    "url": "http://localhost:3000",
                    "path": "${workspaceFolder}/Body"
                }
            ],
            "webRoot": "${workspaceFolder}/Body",
            "firefoxExecutable": "/usr/bin/firefox",
            "preLaunchTask": "Build and Run C Server",
            "postDebugTask": "Kill C Server"
        },
        {
            "type": "firefox",
            "request": "attach",
            "name": "Attach to Firefox"
        },
        {
            "type": "cppdbg",
            "name": "(gdb) Build & Debug C Server",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/webserver",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "cppbuild: C/C++: gcc build active file",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "type": "cppdbg",
            "name": "(gdb) Build Current C File",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "cppbuild: C/C++: gcc build active file",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}