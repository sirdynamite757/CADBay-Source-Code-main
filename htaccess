# Enable mod_rewrite
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite if it's a real file
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  # Don't rewrite if it's a real directory
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Hide .html extension - serve HTML files without .html
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [NC, L]

  # Hide .php extension (if using PHP)
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.*)$ $1.php [NC, L]

  # Redirect URLs with extensions to extensionless versions
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]
  RewriteRule ^(.+)\.php$ /$1 [R=301,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Enable GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule> 